{
  "name": "Auto-ping IndexNow on Blog Post Publish",
  "description": "Pings IndexNow and submits sitemap to GSC when a Pro Tips blog post is published",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"published\") != null) and (.trigger.data.published == true)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "BlogPost"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_ping_indexnow_on_blog_post_publish",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pingIndexNow",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}