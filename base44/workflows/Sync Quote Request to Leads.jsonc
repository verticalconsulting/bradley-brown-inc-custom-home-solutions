{
  "name": "Sync Quote Request to Leads",
  "description": "When a new QuoteRequest is created (AI estimator), automatically create a matching Lead record for CRM tracking.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "QuoteRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_quote_request_to_leads",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncQuoteRequestToLead",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}