{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Project title"
    },
    "short_description": {
      "type": "string",
      "description": "Brief summary for cards"
    },
    "description": {
      "type": "string",
      "description": "Full project description"
    },
    "category": {
      "type": "string",
      "enum": [
        "custom_home",
        "renovation",
        "addition",
        "outdoor"
      ],
      "description": "Project type"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional display tags shown on the portfolio card (e.g. Renovation, Custom Home, Addition)"
    },
    "location": {
      "type": "string",
      "description": "City, MS"
    },
    "square_footage": {
      "type": "number"
    },
    "year_completed": {
      "type": "number"
    },
    "budget_range": {
      "type": "string",
      "enum": [
        "under_250k",
        "250k_500k",
        "500k_1m",
        "over_1m"
      ]
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Image URLs (2 or more renders as a split image)"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "published"
    },
    "duration_months": {
      "type": "number"
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {},
        {
          "user_authenticated": false
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}