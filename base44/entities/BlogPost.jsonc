{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "SEO-friendly blog post title"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly anchor ID"
    },
    "topic": {
      "type": "string",
      "description": "The search topic this post is based on"
    },
    "excerpt": {
      "type": "string",
      "description": "Short summary shown in blog listings"
    },
    "meta_description": {
      "type": "string",
      "description": "SEO meta description (150-160 chars)"
    },
    "content": {
      "type": "string",
      "description": "Full blog post content in markdown"
    },
    "image_url": {
      "type": "string"
    },
    "image_alt_text": {
      "type": "string",
      "description": "Alt text for the hero image"
    },
    "image_prompt": {
      "type": "string",
      "description": "The exact prompt used to generate the hero image"
    },
    "published": {
      "type": "boolean",
      "default": true
    },
    "category": {
      "type": "string",
      "default": "home-remodeling",
      "enum": [
        "home-remodeling",
        "kitchen-remodeling",
        "bathroom-remodeling",
        "outdoor-living",
        "curb-appeal",
        "home-value",
        "interior-updates"
      ]
    }
  },
  "required": [
    "title",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}