{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly anchor ID"
    },
    "topic": {
      "type": "string",
      "description": "The trending search topic this post is based on"
    },
    "content": {
      "type": "string",
      "description": "Full blog post content in markdown"
    },
    "image_url": {
      "type": "string"
    },
    "published": {
      "type": "boolean",
      "default": true
    },
    "category": {
      "type": "string",
      "default": "home-remodeling"
    }
  },
  "required": [
    "title",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}