{
  "name": "QuoteRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "custom_home",
        "renovation",
        "addition",
        "outdoor",
        "other"
      ]
    },
    "location": {
      "type": "string"
    },
    "square_footage_estimate": {
      "type": "number"
    },
    "budget_range": {
      "type": "string"
    },
    "timeline": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_estimate": {
      "type": "string"
    },
    "ai_analysis": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "proposal_sent",
        "in_progress",
        "won",
        "lost"
      ],
      "default": "new"
    },
    "notes": {
      "type": "string"
    },
    "features_selected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "design_style_prompt": {
      "type": "string",
      "description": "Homeowner's free-text description of desired design style"
    },
    "style_preset": {
      "type": "string",
      "description": "Selected style preset slug (e.g. old_english_office, modern_luxury)"
    },
    "design_photo_url": {
      "type": "string",
      "description": "URL of the current room/project photo provided as the design base"
    },
    "inspiration_image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of homeowner-uploaded inspiration images"
    },
    "design_concept_image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of AI-generated remodeling concept images"
    },
    "design_concept_prompt": {
      "type": "string",
      "description": "Final assembled prompt used to generate the design concept"
    }
  },
  "required": [
    "name",
    "email",
    "project_type"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}