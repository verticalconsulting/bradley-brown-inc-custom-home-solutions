{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "project_type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "lead",
        "active",
        "completed",
        "inactive"
      ],
      "default": "lead"
    },
    "notes": {
      "type": "string"
    },
    "budget_range": {
      "type": "string"
    },
    "last_contacted": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "phone"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}